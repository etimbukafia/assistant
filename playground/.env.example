# Playground shared environment template
# Copy to `.env` (and/or `.env.local` for frontend) and adjust as needed.

# ---------------------------
# LLM / GenAI
# ---------------------------
GOOGLE_API_KEY=

# ---------------------------
# Backend cache config
# ---------------------------
# Optional Redis (Redis Cloud/local). If empty, warm cache falls back to in-process.
PLAYGROUND_REDIS_URL=
# Optional fallback key name if you already use REDIS_URL globally.
REDIS_URL=

# Hot cache (in-process session cache)
HOT_CACHE_SESSION_TTL_SECONDS=900
HOT_CACHE_MAX_SESSIONS_GLOBAL=4000
HOT_CACHE_MAX_SESSIONS_PER_USER=20
HOT_CACHE_MAX_MESSAGES_PER_SESSION=20
HOT_CACHE_MAX_CONTEXT_ENTRIES_PER_SESSION=10

# Warm cache (Redis + in-process fallback)
WARM_CACHE_TTL_SECONDS=900
WARM_CACHE_TTL_JITTER_SECONDS=60
WARM_CACHE_MAX_INPROC_ENTRIES=5000
WARM_CACHE_PER_USER_SCOPE_LIMIT=32

# Chat orchestration
CHAT_MAX_AUTO_ACTIONS=5

# ---------------------------
# Frontend
# ---------------------------
NEXT_PUBLIC_PLAYGROUND_API_BASE=http://localhost:8010/api
