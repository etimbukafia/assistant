# Test Email Sender Configuration
# Copy to .env and fill in your values

# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Your Gmail address (where test emails will be sent)
TEST_EMAIL_TO=your-email@gmail.com

# Sender email (optional - defaults to onboarding@resend.dev)
# For custom sender, you need a verified domain in Resend
# TEST_EMAIL_FROM=test@yourdomain.com
