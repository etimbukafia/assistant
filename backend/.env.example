# ===========================================
# Google / Gemini AI
# ===========================================
GOOGLE_API_KEY=your_google_api_key_here

# Gmail OAuth credentials (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# ===========================================
# LLM Model Selection
# ===========================================
# Global defaults (used when per-task models aren't set)
LLM_PROVIDER=gemini
# LLM_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct   # Only for huggingface provider

# Email processing (summarization, extraction, classification)
LLM_EMAIL_PROVIDER=gemini
LLM_EMAIL_MODEL=gemma-3-4b-it

# Chat conversations and reply drafting
LLM_CHAT_PROVIDER=gemini
LLM_CHAT_MODEL=gemini-2.5-flash-lite

# Chat model-call metrics tuning (keeps telemetry off the critical path)
# 1.0 = record all eligible turns, 0.2 = deterministic 20% sample, 0 = disabled
CHAT_METRICS_SAMPLE_RATE=1.0
# Keep payload tiny for hashing/signature metrics
CHAT_METRICS_PROMPT_MAX_MESSAGES=6
CHAT_METRICS_PROMPT_MAX_TOTAL_CHARS=4096
CHAT_METRICS_PROMPT_MAX_CONTENT_CHARS=420
# In-memory previous-signature cache size for repeated-prefix analysis
CHAT_METRICS_SIGNATURE_CACHE_SIZE=10000
# Async telemetry writer (non-critical analytics only)
TELEMETRY_QUEUE_MAX_SIZE=5000
TELEMETRY_BATCH_SIZE=100
TELEMETRY_POLL_TIMEOUT_SECONDS=0.25
TELEMETRY_WARN_EVERY_DROPS=100

# ===========================================
# Cache (Warm Context + Redis)
# ===========================================
# Optional Redis cache (recommended for multi-instance deployments)
# Example: redis://default:password@host:port/0
REDIS_URL=

# Warm cache behavior
WARM_CACHE_TTL_SECONDS=900
WARM_CACHE_TTL_JITTER_SECONDS=60
WARM_CACHE_MAX_INPROC_ENTRIES=5000
WARM_CACHE_PER_USER_SCOPE_LIMIT=32

# Redis fail-fast tuning
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.2
REDIS_SOCKET_TIMEOUT_SECONDS=0.2

# Action chips mutation-time prewarm (keep false for high-churn email workloads)
ACTION_CHIPS_MUTATION_PREWARM=false
ACTION_CHIPS_PREWARM_MIN_INTERVAL_SECONDS=60

# ===========================================
# Database - Supabase (Postgres)
# ===========================================
# Get this from Supabase Project Settings > Database > Connection String > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Prefer Supabase pooler transaction mode for app traffic (port 6543) to avoid max-client session limits:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# SQLAlchemy pool tuning (especially important with Supabase pooler/session mode)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=15

# For local development with SQLite (Phase 2 queue won't work - no row locking)
# DATABASE_URL=sqlite:///./inbox.db

# ===========================================
# OAuth / URLs
# ===========================================
# Gmail API OAuth callback (distinct from Supabase Auth)
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GMAIL_OAUTH_REDIRECT_URI_PROD=https://api.teeks.app/auth/gmail/callback

# Frontend URL for OAuth redirects (Vite default: 5173, Next.js: 3000)
FRONTEND_URL=http://localhost:5173

# Backend public URL — used as the webhook address for Calendar push notifications
# Must be publicly reachable by Google (use a tunnel like ngrok in local dev)
API_URL=https://api.teeks.app

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Environment
# ===========================================
# development | staging | production
# Controls Cloudflare gate enforcement (skipped in production)
ENV=development

# Vault proposal queue (email-derived proposal generation + review endpoints)
# Keep disabled until fully QA'd.
PROPOSALS_ENABLED=false

# ===========================================
# Security
# ===========================================
# Encryption Key for OAuth tokens (REQUIRED for production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this secret! Without it, you cannot decrypt stored tokens.
ENCRYPTION_KEY=your_encryption_key_here

# Admin emails allowed to access internal admin endpoints (comma-separated)
# Example: ADMIN_EMAILS=founder@teeks.ai,ops@teeks.ai
ADMIN_EMAILS=

# ===========================================
# Supabase Auth
# ===========================================
# Get these from Supabase Project Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Get this from Supabase Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ===========================================
# Polar Payment (Subscription Billing)
# ===========================================
# Get these from Polar Dashboard > Settings > Developers
POLAR_API_KEY=pol_live_xxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Get Organization ID from Polar Dashboard URL or API
POLAR_ORGANIZATION_ID=org_xxxxxxxxxxxx

# Get Product ID from Polar Dashboard > Products > Your Pro Plan
POLAR_PRO_PRODUCT_ID=prod_xxxxxxxxxxxx


# ===========================================
# Google Cloud Pub/Sub (Gmail Push Notifications)
# ===========================================
# Get Project ID from Google Cloud Console > Project Settings
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Topic name created in Pub/Sub (default: gmail-notifications)
GMAIL_PUBSUB_TOPIC=gmail-notifications

# Optional: expected Pub/Sub subscription full name
# Example: projects/your-gcp-project-id/subscriptions/gmail-notifications-sub
GMAIL_PUBSUB_SUBSCRIPTION=

# Recommended webhook verification (pick one):
# 1) Shared token mode (simplest): set same token in push endpoint URL/header config
GMAIL_WEBHOOK_TOKEN=
# 2) OIDC mode: verify Google-signed bearer token
GMAIL_WEBHOOK_REQUIRE_AUTH=true
GMAIL_WEBHOOK_AUDIENCE=
# Optional exact service account email expected in OIDC token
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=

# ===========================================
# Cloudflare Zero Trust Service Token
# ===========================================
# Required in dev/staging — get from Cloudflare Zero Trust > Service Auth
# In production (ENV=production), these are ignored.
CF_ACCESS_CLIENT_ID=your_cf_service_token_client_id
CF_ACCESS_CLIENT_SECRET=your_cf_service_token_client_secret
